{
    "name": "scrapyard-io/ux",
    "description": "The ScrapyardIO Node-based-UX library.",
    "license": "MIT",
    "homepage": "https://scrapyard-io.projectsaturnstudios.com",
    "version": "0.6.0",
    "support": {
        "issues": "https://github.com/scrapyard-io/framework/issues",
        "source": "https://github.com/scrapyard-io/framework"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "fabricate/ux": "^0.6.0",
        "fabricate/contracts": "^0.6.0",
        "fabricate/nuts-and-bolts": "^0.6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "ScrapyardIO\\UX\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ScrapyardIO\\UX\\Tests\\": "tests/"
        }
    },
    "extra": {
        "scrapyard-io": {
            "providers": [
                "ScrapyardIO\\UX\\UXServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-master": "0.6.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
}
